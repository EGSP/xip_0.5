# ─── Модель ───────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО. Без этой переменной программа не стартует.
# Короткое имя (тогда нужен YANDEX_FOLDER_ID) либо полный URI gpt://<folder>/<model>.
#   yandexgpt/latest         — основная модель
#   yandexgpt-lite/latest    — быстрая и дешёвая
#   qwen3-235b-a22b-fp8/latest, gpt-oss-120b/latest — открытые модели AI Studio
YANDEX_MODEL=yandexgpt/latest

# Идентификатор каталога Yandex Cloud. Нужен, чтобы собрать URI вида gpt://<folder>/<model>.
# Можно не задавать, только если YANDEX_MODEL записан полным URI gpt://…
YANDEX_FOLDER_ID=

# ─── Аутентификация: IAM-токен ────────────────────────────────────────────────
# Способ 1 (для быстрой проверки). Готовый IAM-токен: `yc iam create-token`.
# Живёт около 12 часов, после чего программу нужно перезапустить с новым значением.
# YANDEX_IAM_TOKEN=

# Способ 2 (основной). Авторизованный ключ сервисного аккаунта: программа сама
# подписывает JWT и меняет его на IAM-токен, обновляя по мере истечения.
# Значения берутся из authorized_key.json, выданного `yc iam key create`.
#   id                 → YANDEX_KEY_ID
#   service_account_id → YANDEX_SERVICE_ACCOUNT_ID
#   private_key        → YANDEX_PRIVATE_KEY
# Переносы строк в ключе записываются как \n в одну строку и в двойных кавычках.
# Преамбулу «PLEASE DO NOT REMOVE THIS LINE!…» удалять не нужно.
YANDEX_KEY_ID=
YANDEX_SERVICE_ACCOUNT_ID=
YANDEX_PRIVATE_KEY=""

# У сервисного аккаунта должна быть роль ai.languageModels.user на каталоге.

# ─── Необязательное ───────────────────────────────────────────────────────────
# Базовый адрес OpenAI-совместимого API. По умолчанию — эндпоинт Chat Completions.
# YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1

# Предел числа шагов в одном ходе агента (защита от бесконечного цикла).
# AGENT_MAX_ITERATIONS=10

# Температура генерации. Ниже — устойчивее вызовы инструментов.
# AGENT_TEMPERATURE=0.3

# Предел размера результата инструмента, отправляемого модели (символов).
# TOOL_RESULT_MAX_CHARS=8000
